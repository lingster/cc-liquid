/* cc-liquid Dynamic Theming System
 *
 * This stylesheet uses CSS variables for all colors, allowing dynamic theme switching.
 * Variables are defined in themes.py and applied via app._apply_theme()
 *
 * Available CSS Variables:
 * - $background: Main background color
 * - $surface: Secondary background (panels, containers)
 * - $primary: Primary accent color
 * - $secondary: Secondary accent color
 * - $text: Default text color
 * - $text-muted: Muted/secondary text color
 * - $success: Success state color
 * - $warning: Warning state color
 * - $error: Error state color
 * - $border: Border color
 * - $border-focus: Focused element border color
 * - $header-bg: Header background
 * - $header-fg: Header text color
 * - $footer-bg: Footer background
 * - $footer-fg: Footer text color
 *
 * Design Philosophy:
 * - Stark, brutal aesthetics with high contrast (default brutalist theme)
 * - Functional over decorative
 * - Edward Tufte-inspired data density
 * - Fully customizable via theme system
 */

/* === Default Theme Variables (Brutalist) === */
/* These are overridden at runtime by selected theme */

$background: #001926;
$surface: #002030;
$primary: #62e4fb;
$secondary: #4152A8;
$text: #62e4fb;
$text-muted: #aaaaaa;
$success: #00ff00;
$warning: #ffaa00;
$error: #ff0000;
$border: #62e4fb;
$border-focus: #62e4fb;
$header-bg: #4152A8;
$header-fg: #62e4fb;
$footer-bg: #002030;
$footer-fg: #62e4fb;

/* === Global Styles === */

Screen {
    background: $background;
}

Header {
    background: $header-bg;
    color: $header-fg;
}

Footer {
    background: $footer-bg;
    color: $footer-fg;
}

/* === Panels and Containers === */

.panel {
    background: $surface;
    border: solid $border;
    padding: 1;
    margin: 1;
}

.section-title {
    text-style: bold;
    color: $primary;
    background: $secondary;
    padding: 0 1;
}

.screen-title {
    text-style: bold;
    color: $primary;
    background: $secondary;
    padding: 0 1;
    margin-bottom: 1;
}

/* === Color Classes === */

.success {
    color: $success;
}

.error {
    color: $error;
}

.warning {
    color: $warning;
}

.info {
    color: $primary;
}

/* === Buttons === */

Button {
    background: $secondary;
    color: $primary;
    border: solid $border;
}

Button:hover {
    background: $primary;
    color: $background;
}

Button:disabled {
    background: $surface;
    color: $text-muted;
    border: solid $border;
}

/* === DataTables === */

DataTable {
    background: $background;
}

DataTable > .datatable--header {
    background: $secondary;
    color: $primary;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $surface;
}

DataTable > .datatable--odd-row {
    background: $background;
}

DataTable > .datatable--even-row {
    background: $surface;
}

/* === Inputs === */

Input {
    background: $surface;
    color: $text;
    border: solid $border;
}

Input:focus {
    border: thick $border-focus;
}

Label {
    color: $text;
}

/* === Select / OptionList === */

OptionList {
    background: $background;
    border: solid $border;
}

OptionList > .option-list--option {
    color: $text;
}

OptionList > .option-list--option-highlighted {
    background: $surface;
    color: $primary;
}

OptionList > .option-list--option-hover {
    background: $surface;
}

/* Dashboard Screen */

#dashboard {
    layout: grid;
    grid-size: 2 2;
    grid-gutter: 1;
    padding: 1;
}

#account-summary {
    padding: 1;
    color: $text;
}

#positions-table {
    height: 100%;
}

/* Trading Screen */

#trading {
    layout: vertical;
    padding: 1;
}

.button-row {
    height: auto;
    padding: 1;
}

.button-row > Button {
    margin-right: 2;
}

#trades-table {
    min-height: 20;
}

#results-panel {
    margin-top: 1;
}

#plan-status {
    padding: 1;
    color: $text;
}

#execution-summary {
    padding: 1;
    color: $text;
}

/* Confirmation Modal */

#confirm-modal {
    width: 60;
    height: auto;
    background: $surface;
    border: solid $border-focus;
    padding: 2;
}

#confirm-message {
    padding: 1;
    text-align: center;
    color: $text;
}

/* Account Screen */

#account {
    layout: vertical;
    padding: 1;
}

#account > Button {
    width: 20;
    margin: 1;
}

#account-metrics {
    padding: 1;
    color: $text;
}

#margin-breakdown {
    padding: 1;
    color: $text;
}

#positions-detail-table {
    min-height: 15;
}

/* History Screen */

#history {
    layout: vertical;
    padding: 1;
}

#date-filters {
    layout: horizontal;
    height: auto;
    padding: 1;
}

#date-filters > Input {
    width: 20;
    margin-right: 2;
}

#date-filters > Label {
    margin-right: 1;
    padding-top: 1;
    color: $text;
}

#history-summary {
    padding: 1;
    color: $text;
}

#history-table {
    min-height: 20;
}

/* Backtest Screen */

#backtest {
    layout: vertical;
    padding: 1;
}

#config-grid {
    grid-size: 2;
    grid-gutter: 1;
    padding: 1;
}

#config-grid > Label {
    text-align: right;
    padding-right: 1;
}

#config-grid > Input {
    width: 30;
}

#performance-metrics, #risk-metrics {
    padding: 1;
    color: $text;
}

/* Optimize Screen */

#optimize {
    layout: vertical;
    padding: 1;
}

#param-ranges-grid {
    grid-size: 2;
    grid-gutter: 1;
    padding: 1;
}

#param-ranges-grid > Label {
    text-align: right;
    padding-right: 1;
    color: $text;
}

#param-ranges-grid > Input {
    width: 30;
}

#metric-container {
    layout: horizontal;
    height: auto;
    padding: 1;
}

#metric-container > Label {
    padding-right: 1;
    padding-top: 1;
    color: $text;
}

#metric-select {
    width: 30;
}

#run-optimization {
    width: 25;
    margin: 1;
}

#optimization-status {
    padding: 1;
    color: $text;
}

#results-table {
    min-height: 15;
}

/* === Config Screen === */

#config-screen {
    layout: vertical;
    padding: 1;
}

.config-section {
    margin: 1;
    padding: 1;
    border: solid $border;
    background: $surface;
}

.config-label {
    color: $primary;
    text-style: bold;
}

.config-value {
    color: $text;
    padding-left: 2;
}

#btn-refresh {
    width: 30;
    margin: 1;
}

#config-display {
    padding: 1;
    color: $text;
}

/* === Modal Styles === */

#confirmation-modal, #result-modal {
    width: 60;
    height: auto;
    background: $surface;
    border: thick $border-focus;
    padding: 2;
}

#modal-title {
    text-style: bold;
    color: $primary;
    text-align: center;
    padding: 1;
}

#modal-message {
    color: $text;
    text-align: center;
    padding: 1 2;
}

#modal-details {
    color: $text-muted;
    text-align: center;
    padding: 1 2;
}

#modal-buttons {
    align: center middle;
    height: auto;
    padding: 1;
}

#modal-buttons > Button {
    margin: 0 1;
}

.success-modal {
    border: thick $success;
}

.error-modal {
    border: thick $error;
}

#btn-yes {
    background: $success;
    color: $background;
}

#btn-yes:hover {
    background: $primary;
    color: $background;
}

#btn-no {
    background: $error;
    color: $text;
}

#btn-no:hover {
    background: $warning;
    color: $background;
}

#btn-ok {
    background: $secondary;
    color: $primary;
}

/* === Widget Styles === */

/* Trade Plan Widget */
TradePlanWidget {
    layout: vertical;
}

/* Order Book Widget */
OrderBookWidget {
    layout: horizontal;
}

.order-book-side {
    width: 50%;
}

/* Config Screen */
#config {
    layout: vertical;
    padding: 1;
}
